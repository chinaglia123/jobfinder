# Copie para .env e preencha o que for usar.

# --- IA (opcional, pelo menos uma; sem chave o app usa análise local) ---
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=

# --- Modo de uso ---
# local  = no seu computador, sem login (padrão)
# hosted = site no ar para várias pessoas, com contas e dados separados
JOBFINDER_MODE=local
# Código exigido para criar conta no modo hosted (deixe vazio para cadastro aberto)
JOBFINDER_CONVITE=
# Banco na nuvem (Turso) — obrigatório na Vercel. Sem isso, usa o SQLite local em .data
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Senha da rotina de atualização (/api/cron/indexar), usada pelo cron da Vercel e pelo GitHub Actions
CRON_SECRET=
# Pasta do banco SQLite local (padrão: .data na raiz do projeto)
JOBFINDER_DATA_DIR=
# Desliga o indexador em segundo plano (sites das empresas, fila do LinkedIn)
# JOBFINDER_INDEXER=off

PORT=3000
